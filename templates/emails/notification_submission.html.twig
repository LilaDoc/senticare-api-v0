<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <style>
        @font-face {
            font-family: 'Inter';
            src: url('{{ absolute_path ~ "/fonts/Inter-Regular.ttf" }}');
            font-weight: normal;
        }
        @font-face {
            font-family: 'Inter';
            src: url('{{ absolute_path ~ "/fonts/Inter-Bold.ttf" }}');
            font-weight: bold;
        }

        :root {
            --color-primary: #5BC0EB;
            --color-secondary: #70AE6E;
            --color-tertiary: #F4743B;
            --color-neutral: #080708;
        }

        body {
            font-family: 'Inter', sans-serif;
            font-size: 11px;
            color: var(--color-neutral);
            margin: 30px;
        }

        h1 {
            font-size: 18px;
            font-weight: bold;
            color: var(--color-neutral);
            border-bottom: 3px solid #5BC0EB;
            padding-bottom: 8px;
        }

        .section {
            margin-top: 20px;
        }

        .section-title {
            font-size: 13px;
            font-weight: bold;
            color: #ffffff;
            background-color: #5BC0EB;
            padding: 6px 10px;
            margin-bottom: 8px;
            border-radius: 4px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        td {
            padding: 4px 6px;
            vertical-align: top;
        }

        .label {
            font-weight: bold;
            width: 220px;
            color: #555;
        }

        .gravite-badge {
            display: inline-block;
            padding: 3px 12px;
            border-radius: 12px;
            font-weight: bold;
            color: #fff;
            background-color: {{ declaration.isEIGS ? '#F4743B' : '#70AE6E' }};
        }

        .footer {
            margin-top: 40px;
            font-size: 9px;
            color: #888;
            text-align: center;
            border-top: 1px solid #eee;
            padding-top: 10px;
        }
    </style>
</head>
<body>

    <h1>Déclaration d'événement indésirable n°{{ declaration.id }}</h1>

    <div class="section">
        <div class="section-title">Informations générales</div>
        <table>
            <tr>
                <td class="label">Service</td>
                <td>{{ declaration.service }}</td>
            </tr>
            <tr>
                <td class="label">Type d'événement</td>
                <td>{{ declaration.typeEi }}</td>
            </tr>
            <tr>
                <td class="label">Date de survenue</td>
                <td>{{ declaration.dateSurvenue ? declaration.dateSurvenue|date('d/m/Y') : '—' }}</td>
            </tr>
            <tr>
                <td class="label">Date de constat</td>
                <td>{{ declaration.dateConstat ? declaration.dateConstat|date('d/m/Y') : '—' }}</td>
            </tr>
            <tr>
                <td class="label">Déclarant</td>
                <td>{{ declaration.declarant }}</td>
            </tr>
            <tr>
                <td class="label">Statut</td>
                <td>{{ declaration.statut }}</td>
            </tr>
        </table>
    </div>

    <div class="section">
        <div class="section-title">Gravité</div>
        <table>
            <tr>
                <td class="label">Gravité calculée</td>
                <td><span class="gravite-badge">{{ declaration.gravite }}</span></td>
            </tr>
            <tr>
                <td class="label">Décès</td>
                <td>{{ declaration.deces ? 'Oui' : 'Non' }}</td>
            </tr>
            <tr>
                <td class="label">Pronostic vital en jeu</td>
                <td>{{ declaration.pronosticVitalEnJeu ? 'Oui' : 'Non' }}</td>
            </tr>
            <tr>
                <td class="label">Risque de déficit fonctionnel permanent</td>
                <td>{{ declaration.risqueDeficitFonctionnelPermanent ? 'Oui' : 'Non' }}</td>
            </tr>
            <tr>
                <td class="label">EIGS</td>
                <td>{{ declaration.isEIGS ? 'Oui' : 'Non' }}</td>
            </tr>
        </table>
    </div>

    <div class="section">
        <div class="section-title">Lieu</div>
        <table>
            <tr>
                <td class="label">Lieu différent du lieu habituel</td>
                <td>{{ declaration.lieuDifferent ? 'Oui' : 'Non' }}</td>
            </tr>
            {% if declaration.lieuDifferent %}
            <tr>
                <td class="label">Détail</td>
                <td>{{ declaration.lieuDifferentDetail }}</td>
            </tr>
            {% endif %}
        </table>
    </div>

    <div class="section">
        <div class="section-title">Description</div>
        <p>{{ declaration.description|nl2br }}</p>
    </div>

    <div class="section">
        <div class="section-title">Mesures immédiates</div>
        <table>
            <tr>
                <td class="label">Sur le patient</td>
                <td>{{ declaration.mesuresImmediatesPatient }}</td>
            </tr>
            {% if declaration.mesuresImmediatesPatientDetail %}
            <tr>
                <td class="label">Détail</td>
                <td>{{ declaration.mesuresImmediatesPatientDetail }}</td>
            </tr>
            {% endif %}
            <tr>
                <td class="label">Sur les proches</td>
                <td>{{ declaration.mesuresImmediatesProches }}</td>
            </tr>
            {% if declaration.autresMesures %}
            <tr>
                <td class="label">Autres mesures</td>
                <td>{{ declaration.autresMesures }}</td>
            </tr>
            {% endif %}
        </table>
    </div>

    <div class="section">
        <div class="section-title">Conséquences</div>
        <table>
            <tr>
                <td class="label">Autres conséquences</td>
                <td>{{ declaration.consequencesAutres ? 'Oui' : 'Non' }}</td>
            </tr>
            {% if declaration.consequencesAutresDetail %}
            <tr>
                <td class="label">Détail</td>
                <td>{{ declaration.consequencesAutresDetail }}</td>
            </tr>
            {% endif %}
        </table>
    </div>

    <div class="footer">
        Document généré le {{ "now"|date('d/m/Y à H:i') }} — Confidentiel
    </div>

</body>
</html>